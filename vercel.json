{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/subscribe", "destination": "/#offres", "permanent": false }
  ],
  "functions": {
    "api/email-center-send.mjs": {
      "maxDuration": 60
    },
    "api/book-coaching-call.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://accounts.google.com https://unpkg.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://xriaekbrswqmosecjmhm.supabase.co wss://xriaekbrswqmosecjmhm.supabase.co https://esm.sh https://world.openfoodfacts.org https://challenges.cloudflare.com; frame-src https://accounts.google.com https://js.stripe.com https://hooks.stripe.com https://challenges.cloudflare.com; base-uri 'self'; form-action 'self' https://checkout.stripe.com; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/env.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/module",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0, must-revalidate, no-transform" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet, noimageindex" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
